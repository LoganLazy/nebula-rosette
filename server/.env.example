# 服务端配置（复制为 .env，或直接用环境变量）

# ---- 大模型 ----
# 服务端持有的兜底 key，浏览器永远看不到它。
# 用户也可以在设置页存自己的 key（加密进 ai_configs 表），账号的优先于这里。
LLM_API_KEY=
LLM_MODEL=qwen-turbo
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 数据库 ----
# SQLite 文件路径，默认 server/nebula.db
DB_PATH=nebula.db

# ---- 静态加密 ----
# 用于加密库里存的用户 API Key。留空则首次启动自动生成 server/.enc_key（0600）。
# 换掉这个值后，已存的 key 全部解不开，需要重新填。
# 备份数据库时务必连密钥一起备份，只有 .db 是解不开的。
CONFIG_ENC_KEY=

# ---- 安全 ----
# 允许访问的前端来源，逗号分隔。部署时必须改成实际域名
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# 建好自己的账号后设为 0，关闭注册
ALLOW_REGISTRATION=1
# 会话有效期（天）
SESSION_DAYS=30
# 口令哈希迭代次数，越高越慢也越安全
PBKDF2_ITERATIONS=260000
# 前面挂了 nginx/Caddy 之类的反代时设为 1，后端才能从 X-Forwarded-For
# 拿到真实来源 IP（否则所有人共用一个限流桶，会互相锁死）。
# 反过来，如果本服务直接暴露在公网，必须保持 0——那个头客户端可以随便伪造，
# 采信它等于关掉了登录限流。docker-compose.yml 里已经设成 1。
TRUST_PROXY=0

# ---- 限流 ----
# AI 提问：按账号
RATE_LIMIT_PER_MIN=10
RATE_LIMIT_PER_DAY=200
# 登录/注册尝试：按来源 IP
LOGIN_ATTEMPTS_PER_MIN=5
